@startuml context
!$NEW_C4_STYLE = 1
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
!include ../../datum-theme.puml

title Project Suspension - System Context\nOne reversible stop: many triggers depend on it, every managed service honors it through the service catalog

Person(operator, "Trust & Safety Operator", "Responds to abuse / ToS violations")

System_Boundary(triggers, "Suspension triggers (declare intent, own no enforcement)") {
    System(fraud, "Fraud Detection", "Automated fraud scoring")
    System(abuse, "Abuse Reports", "Trust & safety review of reported abuse / ToS violations")
    System(billing, "Billing", "A suspended billing account cascades to its projects")
    System(compliance, "Compliance", "Regulatory / legal holds")
}

System(suspension, "Project Suspension", "Platform primitive: one reversible, auditable, non-destructive stop for a project. Records intent, derives the Suspended state, and fans it out.")

System(catalog, "Service Catalog & Managed-Service Pattern", "The single integration contract every managed service already implements — carries the suspension signal to each service, per consumer.")

System_Boundary(services, "Managed services (honor suspension via the one catalog contract)") {
    System(compute, "Compute", "Pause & retain instances")
    System(network, "Networking", "Stop serving, keep config")
    System(dns, "DNS", "Stop answering, keep records")
    System(future, "Future services", "Inherit suspension for free — no bespoke work")
}

System(project, "Consumer Project", "The suspended target — all data and config retained")

Rel_R(operator, abuse, "Reviews and confirms reported abuse / ToS violations")

Rel(fraud, suspension, "Auto-suspends on fraud score")
Rel(abuse, suspension, "Suspends on a confirmed abuse report")
Rel(billing, suspension, "Cascades from a suspended billing account")
Rel(compliance, suspension, "Suspends for a compliance hold")

Rel_R(suspension, project, "Derives the Suspended state on")

Rel(suspension, catalog, "Publishes the Suspended signal per consumer")
Rel(catalog, compute, "Watch & pause (no teardown)")
Rel(catalog, network, "Watch & pause (no teardown)")
Rel(catalog, dns, "Watch & pause (no teardown)")
Rel(catalog, future, "Watch & pause (no teardown)")

SHOW_LEGEND()
@enduml
