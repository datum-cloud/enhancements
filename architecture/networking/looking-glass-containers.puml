@startuml looking-glass-containers
!$NEW_C4_STYLE = 1
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()
LAYOUT_LEFT_RIGHT()
title Looking glass - Container view

Person(customer, "Project member", "Runs a diagnostic from a chosen edge location")
Container_Ext(client, "Portal / datumctl", "Web / CLI", "Creates sessions and displays live results")

System_Boundary(project, "Project control plane") {
    Container_Ext(project_api, "Project API", "Kubernetes API", "Serves LookingGlassSession and checks project permissions")
    Container(controller, "Looking glass controller", "Go", "Binds sessions to a cell, reflects status and records activity")
}

System_Boundary(federation, "Federation") {
    Container_Ext(karmada, "Karmada hub", "Kubernetes API", "Propagates session copies and returns cell status")
}

System_Boundary(cell, "Selected edge cell") {
    Container(endpoint, "Datum Connect endpoint", "Iroh / QUIC", "Accepts client streams and proxies only to the paired gateway")
    Container(gateway, "Looking glass gateway", "Go", "Authenticates sessions, applies limits and streams observations")
    Container_Ext(fabric_gateway, "Galactic fabric gateway", "gRPC", "Selects routers and runs bounded fabric queries")
    Container_Ext(router_agents, "Fabric router agents", "gRPC", "Read routing state and send network probes")
}

Rel(customer, client, "Uses")
Rel(client, project_api, "Creates and watches sessions", "HTTPS")
Rel(controller, project_api, "Admits and updates sessions", "Kubernetes API")
Rel(controller, karmada, "Delivers cell-bound sessions", "Kubernetes API")
Rel(karmada, gateway, "Provides cell copy; receives status", "Kubernetes API")
Rel(client, endpoint, "Connects and receives results", "Iroh / QUIC")
Rel(endpoint, gateway, "Proxies one session", "WebSocket")
Rel(gateway, fabric_gateway, "Executes fabric diagnostic", "mTLS gRPC")
Rel(fabric_gateway, router_agents, "Fans out by router", "mTLS gRPC")

@enduml
