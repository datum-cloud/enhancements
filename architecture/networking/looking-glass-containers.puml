@startuml looking-glass-containers
!$NEW_C4_STYLE = 1
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()
title Looking glass - Container view

Person(customer, "Project member", "Runs a diagnostic from a chosen edge location")
Container_Ext(client, "Portal / datumctl", "Web / CLI", "Creates sessions and displays live results")
Container_Ext(project_api, "Project API", "Kubernetes API", "Serves LookingGlassSession and enforces project permissions")
Container(controller, "Looking glass controller", "Go / project", "Binds sessions to a cell, reflects status and records activity")
Container_Ext(karmada, "Karmada hub", "Kubernetes API", "Delivers cell copies and returns status")
Container(endpoint, "Datum Connect endpoint", "Iroh / edge", "Proxies authenticated client streams to the gateway")
Container(gateway, "Looking glass gateway", "Go / edge", "Authenticates sessions, applies limits and streams observations")
Container_Ext(fabric_gateway, "Galactic fabric gateway", "gRPC / edge", "Selects routers and runs bounded fabric queries")
Container_Ext(router_agents, "Fabric router agents", "gRPC / edge", "Read routing state and send network probes")

Rel_R(customer, client, "Uses")
Rel_R(client, project_api, "Creates session", "HTTPS")
Rel_R(project_api, controller, "Session events", "Kubernetes API")
Rel_R(controller, karmada, "Cell-bound session", "Kubernetes API")
Rel_D(karmada, gateway, "Cell copy and status", "Kubernetes API")
Rel_D(client, endpoint, "Live results", "Iroh / QUIC")
Rel_R(endpoint, gateway, "Session stream", "WebSocket")
Rel_R(gateway, fabric_gateway, "Diagnostic", "mTLS gRPC")
Rel_R(fabric_gateway, router_agents, "Per-router query", "mTLS gRPC")

@enduml
